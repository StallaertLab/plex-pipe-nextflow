manifest {
    name        = 'plexpipe/plex-pipe-nextflow'
    description = 'Nextflow orchestration for PlexPipe: one channel image or one ROI per job.'
    homePage    = 'https://github.com/plexpipe/plex-pipe-nextflow'
    mainScript  = 'main.nf'
    version     = '0.1.0'   // works with PlexPipe 0.1.0 (params.plexpipe_version)
}

params {
    // PlexPipe config YAML (all paths in it must be absolute)
    exp_config      = null

    // the plexpipe command: "plexpipe" if it is on PATH in the jobs,
    // otherwise the full path, e.g. /path/to/env/bin/plexpipe
    plexpipe        = 'plexpipe'

    // PlexPipe version this pipeline is tested with; RUN_SETUP stops if
    // `plexpipe --version` differs. '' skips the check (e.g. a development install).
    plexpipe_version = '0.1.0'

    // Globus (optional): fetch the images from a remote collection
    globus_config   = null
    from_collection = 'remote_source'
    to_collection   = 'local_workstation'
    file_checksum   = false     // transfer images that are already present too
    wait_hours      = 12        // how long a cutting job waits for its transfer

    // run settings
    cleanup         = false     // delete each transferred image once it is cut
    roi_cleanup     = false     // delete each ROI's TIFFs once it is assembled
    overwrite       = false     // overwrite existing masks / tables

    logdir          = "${launchDir}/pipeline_logs"
}

profiles {

    // a laptop / workstation; segmentation runs one ROI at a time
    local {
        process {
            executor = 'local'
            cpus     = 2
            memory   = 4.GB
            time     = 6.h

            withName: RUN_SEGMENTATION {
                cpus     = 4
                memory   = 8.GB
                time     = 1.h
                maxForks = 1
            }
        }
    }

    // Slurm cluster: resources and retries, valid on any cluster. Combine it
    // with a cluster profile below (-profile hpc,bridges2) or your own -c file
    // for partitions, accounts and GPUs.
    hpc {
        process {
            executor = 'slurm'

            withName: RUN_SETUP {
                cpus   = 1
                memory = 1.GB
                time   = 10.min
            }

            // waits for its Globus transfer, then cuts; never retried
            withName: RUN_CUTTING {
                cpus   = 1
                memory = 16.GB
                time   = 12.h
            }

            withName: RUN_ASSEMBLY {
                cpus   = 1
                memory = 16.GB
                time   = 30.min
            }

            withName: RUN_SEGMENTATION {
                errorStrategy = 'retry'
                maxRetries    = 3
                cpus   = 2
                memory = { 16.GB * task.attempt }
                time   = { 10.min * task.attempt }
            }

            withName: RUN_QUANTIFICATION {
                errorStrategy = 'retry'
                maxRetries    = 3
                cpus   = 2
                memory = { 16.GB * task.attempt }
                time   = { 15.min * task.attempt }
            }
        }
    }

    // cluster settings; use after hpc, e.g. -profile hpc,bridges2
    bridges2 { includeConfig 'conf/bridges2.config' }   // PSC Bridges-2
    pitt_crc { includeConfig 'conf/pitt_crc.config' }   // University of Pittsburgh CRC
}

// trace, timeline and report of every run
timeline {
    enabled   = true
    file      = "${params.logdir}/pipeline_reports/timeline.html"
    overwrite = true
}
report {
    enabled   = true
    file      = "${params.logdir}/pipeline_reports/report.html"
    overwrite = true
}
trace {
    enabled   = true
    file      = "${params.logdir}/pipeline_reports/trace.txt"
    overwrite = true
}
