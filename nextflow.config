params {
    // PlexPipe config YAML (all paths in it must be absolute)
    exp_config      = null

    // the plexpipe command: "plexpipe" if it is on PATH in the jobs,
    // otherwise the full path, e.g. /path/to/env/bin/plexpipe
    plexpipe        = 'plexpipe'

    // Globus (optional): fetch the images from a remote collection
    globus_config   = null
    from_collection = 'remote_source'
    to_collection   = 'local_workstation'
    file_checksum   = false     // transfer images that are already present too
    wait_hours      = 12        // how long a cutting job waits for its transfer

    // run settings
    cleanup         = false     // delete each transferred image once it is cut
    roi_cleanup     = false     // delete each ROI's TIFFs once it is assembled
    overwrite       = false     // overwrite existing masks / tables

    logdir          = "${launchDir}/pipeline_logs"
}

profiles {

    // a laptop / workstation; segmentation runs one ROI at a time
    local {
        process {
            executor = 'local'
            cpus     = 2
            memory   = 4.GB
            time     = 6.h

            withName: RUN_SEGMENTATION {
                cpus     = 4
                memory   = 8.GB
                time     = 1.h
                maxForks = 1
            }
        }
    }

    // Slurm cluster. The resources and clusterOptions below are the settings
    // used so far (Pitt CRC); adjust them to your cluster.
    hpc {
        process {
            executor = 'slurm'

            withName: RUN_SETUP {
                cpus   = 1
                memory = 1.GB
                time   = 10.min
                clusterOptions = '--nodes=1 --ntasks-per-node=1'
            }

            // waits for its Globus transfer, then cuts; never retried
            withName: RUN_CUTTING {
                cpus   = 1
                memory = 16.GB
                time   = 12.h
                clusterOptions = '--nodes=1 --ntasks-per-node=1'
            }

            withName: RUN_ASSEMBLY {
                cpus   = 1
                memory = 16.GB
                time   = 30.min
                clusterOptions = '--nodes=1 --ntasks-per-node=1'
            }

            withName: RUN_SEGMENTATION {
                errorStrategy = 'retry'
                maxRetries    = 3
                cpus   = 2
                memory = { 16.GB * task.attempt }
                time   = { 10.min * task.attempt }
                clusterOptions = '--cluster=gpu --partition=l40s --nodes=1 --ntasks-per-node=1 --gres=gpu:1'
            }

            withName: RUN_QUANTIFICATION {
                errorStrategy = 'retry'
                maxRetries    = 3
                cpus   = 2
                memory = { 16.GB * task.attempt }
                time   = { 15.min * task.attempt }
                clusterOptions = '--nodes=1 --ntasks-per-node=1'
            }
        }
    }
}

// trace, timeline and report of every run
timeline {
    enabled   = true
    file      = "${params.logdir}/pipeline_reports/timeline.html"
    overwrite = true
}
report {
    enabled   = true
    file      = "${params.logdir}/pipeline_reports/report.html"
    overwrite = true
}
trace {
    enabled   = true
    file      = "${params.logdir}/pipeline_reports/trace.txt"
    overwrite = true
}
