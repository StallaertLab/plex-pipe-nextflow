params {
    exp_config          = null
    scripts_dir         = "${baseDir}/scripts"

    logdir              = "${baseDir}/../pipeline_logs"

    segment_overwrite   = true
    quantify_overwrite  = true

    envpath             = 'python'

    file_checksum       = false
    wait_time           = 10
}


profiles {

    local {
        process.executor = 'local'
        params.remote_analysis = false
        params.globus_config = null
        params.from_collection = null
        params.to_collection = null
        params.globus_home_setting = null

        process {
            cpus   = 4      
            memory = 8.GB
            time   = 6.h

            withName: RUN_SEGMENTATION {
                cpus = 4
                memory = 24.GB
                time = 1.h
            }
        }
    }

    hpc {
        params.remote_analysis = true
        params.envpath = "/ix1/kkedziora/envs/sdata-env/bin/python"
        
        params.globus_config       = "${baseDir}/../globus_config/globus_config.yaml"
        params.from_collection     = "r_collection_id"
        params.to_collection       = "crcd_collection_id"
        params.globus_home_setting = "single_drive"

        process {
            executor = 'slurm'
            
            withName: RUN_MANAGEMENT {
                cpus   = 1        
                memory = 1.GB    
                time   = 10.min   
                clusterOptions = '--nodes=1 --ntasks-per-node=1'  

            }

            withName: RUN_CUTTING {
                cpus   = 1        
                memory = 16.GB    
                time   = 12.h   
                clusterOptions = '--nodes=1 --ntasks-per-node=1'  

            }

            withName: RUN_ASSEMBLING {
                cpus   = 1        
                memory = 16.GB    
                time   = 30.min   
                clusterOptions = '--nodes=1 --ntasks-per-node=1'  

            }

            withName: RUN_SEGMENTATION {
                errorStrategy = 'retry'
                maxRetries = 3
                
                cpus    = 2
                memory  = {16.GB * task.attempt}
                time    = {10.min * task.attempt}
                clusterOptions = '--cluster=gpu --partition=l40s --nodes=1 --ntasks-per-node=1 --gres=gpu:1'
            }


            withName: RUN_QUANTIFICATION {
                errorStrategy = 'retry'
                maxRetries = 3

                cpus   = 2         
                memory = {16.GB * task.attempt}    
                time   = {15.min * task.attempt}    
                clusterOptions = '--nodes=1 --ntasks-per-node=1'  
            }

        }
    }
}

// Enable trace, timeline, and report generation
timeline {
    enabled = true
    file = "${params.logdir}/pipeline_reports/timeline.html"
    overwrite = true
}
report {
    enabled = true
    file = "${params.logdir}/pipeline_reports/report.html"
    overwrite = true
}
trace {
    enabled = true
    file = "${params.logdir}/pipeline_reports/trace.txt"
    overwrite = true
}