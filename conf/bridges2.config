// PSC Bridges-2 (https://www.psc.edu/resources/bridges-2/user-guide/).
// Use after the hpc profile:  -profile hpc,bridges2
//
//   --account <allocation>  allocation to charge (default: your default allocation)
//   --gpu_type <type>       GPU for segmentation: v100-16, v100-32 (default),
//                           l40s-48, h100-80
//
// RM-shared gives 2 GB of memory per core and does not accept memory requests,
// so the CPU steps ask for cores instead (cores = memory needed / 2 GB), and no
// step sends a memory request.

params {
    account  = null
    gpu_type = 'v100-32'
}

process {
    queue          = 'RM-shared'
    clusterOptions = { params.account ? "--account=${params.account}" : '' }

    withName: RUN_SETUP {
        cpus   = 1
        memory = null
    }
    withName: RUN_CUTTING {
        cpus   = 8                       // 16 GB
        memory = null
    }
    withName: RUN_ASSEMBLY {
        cpus   = 8                       // 16 GB
        memory = null
    }
    withName: RUN_QUANTIFICATION {
        cpus   = { 8 * task.attempt }    // 16 GB, more on each retry
        memory = null
    }
    withName: RUN_SEGMENTATION {
        queue          = 'GPU-shared'
        memory         = null
        clusterOptions = { (params.account ? "--account=${params.account} " : '') + "--gpus=${params.gpu_type}:1" }
    }
}
